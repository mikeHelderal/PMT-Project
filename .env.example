# Copier ce fichier en `.env` puis renseigner les valeurs.
# `.env` est ignore par Git : aucun identifiant ne doit etre commite.

# --- SMTP : notifications e-mail lors de l'assignation / modification d'une tache
# En developpement, un bac a sable Mailtrap (https://mailtrap.io) suffit :
# creer une inbox, onglet "SMTP Settings", puis recopier les identifiants ici.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
